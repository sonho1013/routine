# Streamlit Cloud secrets template
#
# Copy these key/value pairs into the "Secrets" panel of your Streamlit Cloud
# app (App settings → Secrets). They will be injected as environment variables
# at runtime, so the app code reads them via os.getenv exactly as it does
# locally with .env.
#
# Do NOT commit the real secrets.toml to git. .gitignore already excludes it.

# ── Tier 1: OpenAI direct (required) ──
OPENAI_API_KEY = "sk-..."

# ── Tier 2: OpenRouter (required for cloud-side redundancy) ──
OPENROUTER_API_KEY = "sk-or-..."

# ── Tier 3: Home tunnel — leave EMPTY on Streamlit Cloud ──
# The home tunnel is a desktop-only fallback for the on-site demo laptop.
# It cannot be reached from Cloud reliably, and exposing it publicly is a
# bad idea. The 3-tier chain on Cloud collapses to OpenAI → OpenRouter → cache.
TUNNEL_BASE_URL = ""
TUNNEL_OPENAI_KEY = ""

# ── Cache mode ──
# Recommend setting to 1 on the public app so anonymous visitors cannot
# poison the LLM cache by submitting novel prompts.
LLM_CACHE_READ_ONLY = "1"
